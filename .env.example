NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://ttvasynaxkkcwrmvlorg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required for shared rate limits and PIN storage
SUPABASE_SERVICE_ROLE_KEY=
# Generate independently: openssl rand -hex 32
PIN_PEPPER=
RATE_LIMIT_SECRET=
# Optional protected HTTP publishing fallback; Supabase Cron is primary
CRON_SECRET=

# Stage 4 — disabled by default; choose provider/model in /admin/ai/settings.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
# Milliseconds; bounded to 1–30 seconds per provider request.
AI_TIMEOUT=20000
AI_MAX_OUTPUT_TOKENS=800
# Enable only after verifying the configured API supports SSE chat completions.
AI_STREAMING_SUPPORTED=false
# Telegram secrets are server-only. BotFather token must be set in the bot service
# and web API (getFile). Use two independent random secrets, >=32 characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GATEWAY_SECRET=
# Actual HTTPS gateway URL ending /webhook; never invent a deployment address.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MODE=webhook
# Botkeep SERVER_PORT / Railway PORT are provided by the runtime.
