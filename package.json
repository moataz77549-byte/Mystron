  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:test": "vitest run tests/database.test.ts",
    "security:client": "node scripts/check-client-secrets.mjs",
    "test:cms": "playwright test --config playwright.cms.config.ts",
    "test:python": "PYTHONPATH=services/telegram-bot python -m unittest discover -s services/telegram-bot/tests -v",
    "lint:python": "python -m ruff check services/telegram-bot && python -m ruff format --check services/telegram-bot",
    "release:check": "node scripts/release-preflight.mjs",
    "test:release": "node --test scripts/release-preflight.test.mjs scripts/db-release.test.mjs"
  },
